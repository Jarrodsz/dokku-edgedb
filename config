#!/usr/bin/env bash
_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export GEL_IMAGE=${GEL_IMAGE:="$(awk -F '[ :]' '{print $2}' "${_DIR}/Dockerfile")"}
export GEL_IMAGE_VERSION=${GEL_IMAGE_VERSION:="$(awk -F '[ :]' '{print $3}' "${_DIR}/Dockerfile")"}
export GEL_ROOT=${GEL_ROOT:="$DOKKU_LIB_ROOT/services/gel"}
export DOKKU_LIB_HOST_ROOT=${DOKKU_LIB_HOST_ROOT:=$DOKKU_LIB_ROOT}
export GEL_HOST_ROOT=${GEL_HOST_ROOT:="$DOKKU_LIB_HOST_ROOT/services/gel"}

export PLUGIN_UNIMPLEMENTED_SUBCOMMANDS=()
export PLUGIN_COMMAND_PREFIX="gel"
export PLUGIN_CONFIG_ROOT=${PLUGIN_CONFIG_ROOT:="$DOKKU_LIB_ROOT/config/$PLUGIN_COMMAND_PREFIX"}
export PLUGIN_DATA_ROOT=$GEL_ROOT
export PLUGIN_DATA_HOST_ROOT=$GEL_HOST_ROOT
export PLUGIN_DATASTORE_PORTS=(5656 10700)
export PLUGIN_DATASTORE_WAIT_PORT=5656
export PLUGIN_DATASTORE_WAIT_TIME=120
export PLUGIN_DEFAULT_ALIAS="GEL"
export PLUGIN_CONFIG_DIRECTORY="/gel-config"
export PLUGIN_DISABLE_PULL=${GEL_DISABLE_PULL:=}
export PLUGIN_DISABLE_PULL_VARIABLE="GEL_DISABLE_PULL"
export PLUGIN_ALT_ALIAS="DOKKU_GEL"
export PLUGIN_IMAGE=$GEL_IMAGE
export PLUGIN_IMAGE_VERSION=$GEL_IMAGE_VERSION
export PLUGIN_CLI_IMAGE="gel/gel-cli:6.1.2"
export PLUGIN_SCHEME="gel"
export PLUGIN_SERVICE="Gel"
export PLUGIN_VARIABLE="GEL"
export PLUGIN_BASE_PATH="$PLUGIN_PATH"
export PLUGIN_CONFIG_SUFFIX="config"
if [[ -n $DOKKU_API_VERSION ]]; then
  export PLUGIN_BASE_PATH="$PLUGIN_ENABLED_PATH"
fi

export PLUGIN_BUSYBOX_IMAGE="busybox:1.34.1-uclibc"
export PLUGIN_AMBASSADOR_IMAGE="dokku/ambassador:0.5.0"
export PLUGIN_S3BACKUP_IMAGE="dokku/s3backup:0.14.0"
export PLUGIN_WAIT_IMAGE="dokku/wait:0.6.0"

export GEL_CONFIG_OPTIONS=${GEL_CONFIG_OPTIONS:=""}
